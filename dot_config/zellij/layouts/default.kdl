layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab {
        pane
    }

    // --- Swap tiled layouts ---
    // pane count includes compact-bar (1) + terminal panes
    // e.g. 2 terminal panes = exact_panes=3 (1 compact-bar + 2 terminals)

    // 2 panes: 1:1
    swap_tiled_layout name="1:1" {
        tab exact_panes=3 {
            pane split_direction="vertical" {
                pane size="50%"
                pane size="50%"
            }
        }
    }

    // 2 panes: 2:1
    swap_tiled_layout name="2:1" {
        tab exact_panes=3 {
            pane split_direction="vertical" {
                pane size="67%"
                pane size="33%"
            }
        }
    }

    // 2 panes: 1:2
    swap_tiled_layout name="1:2" {
        tab exact_panes=3 {
            pane split_direction="vertical" {
                pane size="33%"
                pane size="67%"
            }
        }
    }

    // 3 panes: 1:1:1
    swap_tiled_layout name="1:1:1" {
        tab exact_panes=4 {
            pane split_direction="vertical" {
                pane size="33%"
                pane size="33%"
                pane size="33%"
            }
        }
    }

    // 3 panes: left + right split horizontally
    swap_tiled_layout name="split-right" {
        tab exact_panes=4 {
            pane split_direction="vertical" {
                pane size="50%"
                pane size="50%" split_direction="horizontal" {
                    pane
                    pane
                }
            }
        }
    }

    // --- Swap floating layouts ---

    swap_floating_layout name="default" {
        // 1 pane: centered 80%x80%
        floating_panes exact_panes=1 {
            pane {
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            }
        }
        // 2 panes: side by side
        floating_panes exact_panes=2 {
            pane {
                x "1%"
                y "10%"
                width "48%"
                height "80%"
            }
            pane {
                x "51%"
                y "10%"
                width "48%"
                height "80%"
            }
        }
        // 3+ panes: staggered
        floating_panes min_panes=3 {
            pane {
                x "5%"
                y "5%"
                width "80%"
                height "80%"
            }
            pane {
                x "9%"
                y "9%"
                width "80%"
                height "80%"
            }
            pane {
                x "13%"
                y "13%"
                width "80%"
                height "80%"
            }
        }
    }
}
