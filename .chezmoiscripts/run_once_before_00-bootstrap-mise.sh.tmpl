#!/bin/bash
set -euo pipefail

# mise を user-space に bootstrap する。
# run_once_before_* で他の chezmoi スクリプトより先に実行される。
# 後続の run_onchange_after_30-mise-install.sh が `mise install` を呼べる前提を満たす。

if command -v mise >/dev/null 2>&1; then
    echo "[=] mise already installed: $(mise --version)"
    exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "[!] curl not found. Install curl first (distro-provided)." >&2
    exit 1
fi

echo "[*] mise not found; installing via mise.run..."
curl -fsSL https://mise.run | sh

if [ ! -x "$HOME/.local/bin/mise" ]; then
    echo "[!] mise install appears to have failed: $HOME/.local/bin/mise not executable" >&2
    exit 1
fi

echo "[OK] mise installed at: $HOME/.local/bin/mise"
echo "[!] After chezmoi apply finishes, start a new shell or run:"
echo "    eval \"\$(\$HOME/.local/bin/mise activate --shims zsh)\""
